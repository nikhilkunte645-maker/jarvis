# ============================================================
# JARVIS – Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Cloud LLM (only needed when brain.backend != ollama) ──
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Wake-Word (Porcupine backend) ──
PORCUPINE_ACCESS_KEY=

# ── ADB Device Serial (overrides config) ──
JARVIS_PHONE_SERIAL=

# ── Override config file path ──
JARVIS_CONFIG=jarvis/config/settings.yaml

# ── Log level override ──
JARVIS_LOG_LEVEL=INFO
